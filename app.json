{
  "expo": {
    "name": "Sapp",
    "slug": "sapp",
    "version": "6.0.0",
    "orientation": "portrait",
    "icon": "./assets/LOGONOWEpupildoapki.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "sapp",
    "splash": {
      "backgroundColor": "#083A64"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "backgroundColor": "#12100F",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/LOGONOWEpupildoapki.png",
        "backgroundColor": "#083A64"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "package": "com.sokki.sapp",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.VIBRATE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_TOTAL_CALORIES_BURNED",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_OXYGEN_SATURATION",
        "android.permission.health.READ_VO2_MAX",
        "android.permission.health.READ_HYDRATION",
        "android.permission.health.READ_FLOORS_CLIMBED",
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_RESPIRATORY_RATE",
        "android.permission.health.READ_BODY_FAT",
        "android.permission.health.READ_BASAL_METABOLIC_RATE",
        "android.permission.health.READ_LEAN_BODY_MASS",
        "android.permission.health.READ_BODY_WATER_MASS",
        "android.permission.health.READ_NUTRITION"
      ]
    },
    "updates": {
      "url": "https://u.expo.dev/33853b1e-53bc-4779-91e4-18e0714c53c4"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-updates",
      [
        "expo-notifications",
        {
          "color": "#6C63FF",
          "sounds": []
        }
      ],
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1020705470960-3ki9emg74h6emun2nv1eh8cldgp2pn7a"
        }
      ],
      "react-native-health-connect",
      "./plugins/withHealthConnectQueries",
      "./plugins/withAppShortcuts",
      "./plugins/withBankNotificationListener",
      "./plugins/withNativeCrashCatcher",
      "./plugins/withResizeConfig",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "33853b1e-53bc-4779-91e4-18e0714c53c4"
      }
    },
    "owner": "sapp_v2"
  }
}
