# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# Keystore (never commit - stored as GitHub secret)
*.keystore

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env

# Sensitive config — keys stored in GitHub Secrets
.env.local
# google-services.json NIE jest tu (2026-09-15, audyt bezpieczeństwa) — wpis tu był
# mylący: plik jest CELOWO commitowany w repo (publiczna konfiguracja klienta Firebase —
# apiKey/appId dla mobilnej apki NIE są sekretem, bezpieczeństwo egzekwują reguły
# Firestore po stronie serwera, nie ukrywanie tego pliku) i wymagany przez build.yml
# (`cp google-services.json android/app/`). Ignorowanie go tu i tak nic nie chowało —
# był już śledzony przed dodaniem tej reguły.

# Build artifacts
*.apk
*.aab

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Local scratch dropped in the repo root — not source (installers, scans, data
# exports, throwaway test images). Keeps a stray `git add -A` from committing 87 MB.
EpicInstaller-*.exe
Scanned_*.pdf
sapp-export-*.json
iawdawd*.jpg
imawdaw*.jpg
imagepij*.jpg
